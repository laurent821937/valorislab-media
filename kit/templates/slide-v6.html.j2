<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<style>
{% for w in [400,500,600,700,800] %}
@font-face{font-family:"Inter";src:url("../fonts/inter-latin-{{ w }}-normal.woff2") format("woff2");font-weight:{{ w }};unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:"Inter";src:url("../fonts/inter-latin-ext-{{ w }}-normal.woff2") format("woff2");font-weight:{{ w }};unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}
{% endfor %}
/* Charte v6 (20/11/2026) : docs/STYLE-CARROUSEL.md, brief docs/brief-refonte-carrousels-2026-11.md (sections 4 et 5) */
:root{
  --W:{{ W }}px; --H:{{ H }}px; --s:1; --u:calc(1px * var(--s));
{% if bg == "light" %}
  --bg:#F3EEE4; --ink:#1F1D1A; --body:#2E2B27; --sub:#5E574D; --acc:#89692F; --acc-soft:rgba(137,105,47,.14);
  --card:#FFFDF8; --card-line:#D9CBB0; --card-ink:#1F1D1A; --card-sub:#5E574D; --card-acc:#89692F;
  --bubble:#FFFDF8; --bubble-ink:#1F1D1A; --me:#1F1D1A; --me-ink:#F3EEE4; --ring-bg:#1F1D1A;
{% else %}
  --bg:#141416; --ink:#F6F2EA; --body:#E2DDD4; --sub:#B9B2A7; --acc:#E5C07B; --acc-soft:rgba(229,192,123,.14);
  --card:#F3EEE4; --card-line:#D9CBB0; --card-ink:#1C1A17; --card-sub:#5E574D; --card-acc:#8A6A2E;
  --bubble:#2A2A2E; --bubble-ink:#F6F2EA; --me:#E5C07B; --me-ink:#1A1612; --ring-bg:#0C0B0A;
{% endif %}
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{width:var(--W);height:var(--H);overflow:hidden;background:var(--bg)}
body{position:relative;color:var(--ink);font-family:"Inter",system-ui,sans-serif;-webkit-font-smoothing:antialiased;text-rendering:geometricPrecision}
{% if bg == "light" %}
.glow{position:absolute;inset:0;pointer-events:none;background:radial-gradient(820px 700px at {{ halo_x }}% {{ halo_y }}%, rgba(255,255,255,.75), rgba(255,255,255,0) 75%)}
{% else %}
.glow{position:absolute;inset:0;pointer-events:none;background:radial-gradient(760px 640px at {{ halo_x }}% {{ halo_y }}%, rgba(92,72,52,.42), rgba(58,46,36,.18) 55%, transparent 80%)}
{% endif %}

/* --- frame: format tag (top left), counter (top right), monogram (bottom left) ; nothing below y 1190 (TikTok) */
.tag{position:absolute;z-index:6;left:72px;top:64px;padding:12px 22px;border:2px solid var(--acc);border-radius:999px;background:var(--bg);
  font-weight:700;font-size:24px;letter-spacing:.08em;text-transform:uppercase;color:var(--acc);white-space:nowrap}
.count{position:absolute;z-index:6;right:72px;top:72px;padding:6px 14px;border-radius:12px;background:var(--bg);
  font-weight:600;font-size:28px;color:var(--sub);font-variant-numeric:tabular-nums}
footer{position:absolute;z-index:6;left:72px;right:72px;top:1112px;height:60px;display:flex;align-items:center;justify-content:space-between}
.mono{display:flex;align-items:center;gap:14px}
.mono .ring{width:56px;height:56px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--ring-bg);border:1.5px solid rgba(201,169,110,.7)}
.mono .ring img{width:40px;height:auto}
.mono .w{font-weight:600;font-size:20px;letter-spacing:.3em;color:var(--ink)}
footer .disclaimer{font-size:20px;color:var(--sub)}

/* --- content area */
main{position:absolute;z-index:5;left:72px;right:104px;top:170px;bottom:250px;display:flex;flex-direction:column;overflow:hidden}
em{font-style:normal;color:var(--acc)}
strong{font-weight:700}
.kicker{font-weight:700;font-size:calc(26 * var(--u));letter-spacing:.06em;text-transform:uppercase;color:var(--acc);margin-bottom:calc(26 * var(--u))}
.title{font-weight:800;font-size:calc(82 * var(--u));line-height:1.06;letter-spacing:-.02em;color:var(--ink)}
.body{font-weight:500;font-size:calc(44 * var(--u));line-height:1.36;color:var(--body);margin-top:calc(34 * var(--u))}
.note,.source{font-size:calc(24 * var(--u));line-height:1.4;color:var(--sub);margin-top:calc(24 * var(--u))}
.source b{color:var(--acc);font-weight:700}
main > :first-child{margin-top:auto}
.next{margin-top:auto;padding-top:calc(24 * var(--u));display:flex;align-items:center;gap:16px;font-weight:700;font-size:calc(40 * var(--u));color:var(--acc)}
.next::after{content:"→";font-size:1.15em}
.big{font-weight:800;font-size:calc(190 * var(--u));line-height:.95;letter-spacing:-.04em;color:var(--acc);margin-top:calc(30 * var(--u));white-space:nowrap}
.big-lab{font-weight:600;font-size:calc(36 * var(--u));line-height:1.3;color:var(--ink);margin-top:calc(16 * var(--u))}

/* cards (light on dark, white on light) */
.card{background:var(--card);border:1.5px solid var(--card-line);border-radius:26px;color:var(--card-ink);box-shadow:0 18px 40px rgba(0,0,0,{{ ".10" if bg == "light" else ".35" }})}
.opts{display:flex;flex-direction:column;gap:calc(18 * var(--u));margin-top:calc(34 * var(--u))}
.opt{display:flex;align-items:center;gap:calc(28 * var(--u));padding:calc(24 * var(--u)) calc(30 * var(--u))}
.opt .l{flex:0 0 auto;width:calc(84 * var(--u));height:calc(84 * var(--u));border-radius:50%;display:flex;align-items:center;justify-content:center;
  background:var(--card-acc);color:#FFFDF8;font-weight:800;font-size:calc(44 * var(--u))}
.opt .t b{display:block;font-weight:700;font-size:calc(40 * var(--u));line-height:1.2;color:var(--card-ink)}
.opt .t span{display:block;font-size:calc(32 * var(--u));line-height:1.3;color:var(--card-sub);margin-top:calc(4 * var(--u))}
.opt .v{margin-left:auto;font-weight:800;font-size:calc(44 * var(--u));color:var(--card-acc);white-space:nowrap}
.opt.out{background:#D8D1C4;border-color:#C4B9A6;box-shadow:none}
.opt.out .v{text-decoration:line-through}
.opt.win{outline:5px solid var(--acc);outline-offset:4px}

.cols{display:grid;grid-template-columns:1fr 1fr;margin-top:calc(34 * var(--u));padding:calc(30 * var(--u)) 0}
.cols .col{padding:0 calc(30 * var(--u));min-width:0}
.cols .col+.col{border-left:1.5px solid rgba(138,106,46,.35)}
.cols .lab{font-weight:700;font-size:calc(26 * var(--u));text-transform:uppercase;letter-spacing:.03em;color:var(--card-sub)}
.cols .val{font-weight:800;font-size:calc(100 * var(--u));line-height:1.05;letter-spacing:-.02em;color:var(--card-ink);margin-top:calc(18 * var(--u));white-space:nowrap}
.cols .col:first-child .val{color:var(--card-acc)}
.cols .txt{font-size:calc(30 * var(--u));line-height:1.35;color:var(--card-ink);margin-top:calc(12 * var(--u))}

ol.steps{list-style:none;margin-top:calc(34 * var(--u));display:flex;flex-direction:column;gap:calc(16 * var(--u))}
ol.steps li{display:flex;align-items:center;gap:calc(24 * var(--u));padding:calc(22 * var(--u)) calc(28 * var(--u))}
ol.steps .n{flex:0 0 auto;font-weight:800;font-size:calc(40 * var(--u));color:var(--card-acc);font-variant-numeric:tabular-nums}
ol.steps .t{font-size:calc(34 * var(--u));line-height:1.3;color:var(--card-ink)}
ol.steps .t span{display:block;font-size:calc(30 * var(--u));color:var(--card-sub)}

/* chat (F7) */
.chat{display:flex;flex-direction:column;gap:calc(20 * var(--u));margin-top:calc(30 * var(--u))}
.msg{max-width:86%;padding:calc(26 * var(--u)) calc(34 * var(--u));border-radius:36px;font-size:calc(42 * var(--u));line-height:1.32;font-weight:500}
.msg.them{align-self:flex-start;background:var(--bubble);color:var(--bubble-ink);border-bottom-left-radius:10px;{% if bg == "light" %}border:1.5px solid var(--card-line);{% endif %}}
.msg.me{align-self:flex-end;background:var(--me);color:var(--me-ink);border-bottom-right-radius:10px}
.msg.flag{outline:5px solid var(--acc);outline-offset:5px}
.flagnote{align-self:flex-start;display:inline-flex;align-items:center;gap:12px;padding:calc(8 * var(--u)) calc(18 * var(--u));border-radius:12px;background:var(--acc);
  color:{{ "#FFFDF8" if bg == "light" else "#1A1612" }};font-weight:800;font-size:calc(28 * var(--u));text-transform:uppercase;letter-spacing:.03em;margin-top:calc(-4 * var(--u))}
.who{font-size:calc(24 * var(--u));color:var(--sub);font-weight:600;letter-spacing:.04em;text-transform:uppercase}

/* stamp (F2) */
.stamp{display:inline-block;align-self:flex-start;transform:rotate(-7deg);padding:calc(14 * var(--u)) calc(34 * var(--u));border:calc(8 * var(--u)) double var(--acc);border-radius:18px;
  font-weight:800;font-size:calc(86 * var(--u));letter-spacing:.06em;text-transform:uppercase;color:var(--acc);line-height:1;white-space:nowrap}
.stamp.huge{font-size:calc(150 * var(--u));margin:calc(30 * var(--u)) 0 calc(20 * var(--u)) calc(10 * var(--u))}

/* receipt (F6) and dossier / document (F3, F4) */
.ticket{align-self:flex-start;width:100%;padding:calc(30 * var(--u)) calc(36 * var(--u));font-family:"Inter";font-variant-numeric:tabular-nums;margin-top:calc(30 * var(--u))}
.ticket .row{display:flex;justify-content:space-between;gap:24px;font-size:calc(34 * var(--u));line-height:1.5;color:var(--card-ink)}
.ticket .row.new{color:var(--card-acc);font-weight:700}
.ticket .row.total{border-top:3px dashed var(--card-line);margin-top:calc(12 * var(--u));padding-top:calc(12 * var(--u));font-weight:800;font-size:calc(42 * var(--u))}
.fict{font-size:calc(22 * var(--u));font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--card-sub);margin-bottom:calc(8 * var(--u))}

/* --- cover */
.t-cover main,.t-hook main{top:{{ 520 if visual == "face" else 170 }}px;bottom:250px}
.t-cover .title,.t-hook .title{font-size:calc(112 * var(--u));line-height:1.0;letter-spacing:-.03em}
.t-cover .big,.t-hook .big{font-size:calc(220 * var(--u));margin:0 0 calc(18 * var(--u))}
.t-cover .sub,.t-hook .sub{font-weight:600;font-size:calc(40 * var(--u));color:var(--sub);margin-top:calc(26 * var(--u))}
.t-cover .msg,.t-hook .msg{font-size:calc(44 * var(--u));margin-bottom:calc(34 * var(--u))}
.t-cover .stamp,.t-hook .stamp{margin-top:calc(46 * var(--u));margin-bottom:calc(30 * var(--u));margin-left:calc(8 * var(--u))}
.t-cover main > :last-child,.t-hook main > :last-child{margin-bottom:auto}
.t-cover .quote,.t-hook .quote{font-weight:800;font-size:calc(170 * var(--u));line-height:1;color:var(--acc);height:calc(120 * var(--u));margin-bottom:calc(10 * var(--u))}
{% if visual == "face" %}
.photo{position:absolute;left:0;right:0;top:0;height:600px;z-index:1;overflow:hidden;
  -webkit-mask-image:linear-gradient(180deg,#000 0,#000 72%,transparent 100%);mask-image:linear-gradient(180deg,#000 0,#000 72%,transparent 100%)}
.photo img{width:100%;height:100%;object-fit:cover;object-position:{{ photo_pos }};filter:{{ "brightness(1.05) saturate(.9)" if bg == "light" else "saturate(.9)" }}}
{% endif %}

/* --- last slide (guide) */
.t-cta main > :first-child{margin-top:auto}
.t-cta main > :last-child{margin-bottom:auto}
.t-cta .title{font-size:calc(84 * var(--u))}
.t-cta .body{font-size:calc(40 * var(--u))}
.cta-btn{align-self:flex-start;margin-top:calc(46 * var(--u));padding:calc(22 * var(--u)) calc(44 * var(--u));border-radius:18px;background:var(--acc);
  color:{{ "#FFFDF8" if bg == "light" else "#1A1612" }};font-weight:800;font-size:calc(40 * var(--u));letter-spacing:.01em}
.url{font-weight:700;font-size:calc(36 * var(--u));color:var(--ink);margin-top:calc(40 * var(--u))}
</style>
</head>
<body class="t-{{ s.type }} bg-{{ bg }}">
<div class="glow"></div>
{% if visual == "face" and s.type in ["cover", "hook"] %}<div class="photo"><img src="{{ photo_src }}" alt=""></div>{% endif %}
{% if tag %}<div class="tag">{{ tag }}</div>{% endif %}
{% if s.type != "hook" %}<div class="count">{{ i }}/{{ n }}</div>{% endif %}

<main id="main">
{% if s.type in ["cover", "hook"] %}
  {% set v = s.visual or {} %}
  {% if v.type == "bubble" or v.bubble %}<div class="msg them">{{ (v.text if v.type == "bubble" else v.bubble)|md }}</div>{% endif %}
  {% if v.type == "ticket" %}<div class="ticket card"><div class="fict">{{ v.label or "Exemple fictif" }}</div>{% for r in v.rows %}<div class="row{% if loop.last %} total{% endif %}"><span>{{ r[0] }}</span><span>{{ r[1] }}</span></div>{% endfor %}</div>{% endif %}
  {% if v.type == "stamp" %}<div class="quote">«</div>{% endif %}
  {% if s.number %}<div class="big">{{ s.number }}</div>{% endif %}
  <div class="title">{{ s.title|md }}</div>
  {% if s.subtitle %}<div class="sub">{{ s.subtitle|md }}</div>{% endif %}
  {% if v.type == "stamp" %}<div class="stamp">{{ v.text or "Verdict ?" }}</div>{% endif %}
  {% if v.type in ["dossier", "document"] %}<div class="note" style="font-weight:700;color:var(--acc)">{{ v.text or ("Cas fictif" if v.type == "dossier" else "Document fictif") }}</div>{% endif %}

{% elif s.type == "cta" %}
  <div class="kicker">{{ s.kicker or "Le guide gratuit" }}</div>
  <div class="title">{{ s.title|md }}</div>
  <div class="body">{{ s.body|md }}</div>
  <div class="cta-btn">{{ s.button or "Lien dans ma bio" }} →</div>
  <div class="url">valorislab.be</div>

{% else %}
  {% if s.kicker %}<div class="kicker">{{ s.kicker }}</div>{% endif %}
  {% if s.type == "verdict" %}<div class="stamp huge">{{ s.stamp }}</div>{% endif %}
  {% if s.title %}<div class="title">{{ s.title|md }}</div>{% endif %}
  {% if s.type == "chat" %}
  {% if s.who %}<div class="who" style="margin-top:calc(22 * var(--u))">{{ s.who }}</div>{% endif %}
  <div class="chat">{% for m in s.messages %}<div class="msg {{ m.from or 'them' }}{% if m.flag %} flag{% endif %}">{{ m.text|md }}</div>{% if m.flag %}<div class="flagnote">{{ m.flag }}</div>{% endif %}{% endfor %}</div>
  {% endif %}
  {% if s.body %}<div class="body">{{ s.body|md }}</div>{% endif %}
  {% if s.big %}<div class="big">{{ s.big.value }}</div>{% if s.big.label %}<div class="big-lab">{{ s.big.label|md }}</div>{% endif %}{% endif %}
  {% if s.options %}<div class="opts">{% for o in s.options %}<div class="opt card{% if o.state == 'out' %} out{% endif %}{% if o.state == 'win' %} win{% endif %}"><div class="l">{{ o.letter }}</div><div class="t"><b>{{ o.label|md }}</b>{% if o.detail %}<span>{{ o.detail|md }}</span>{% endif %}</div>{% if o.value %}<div class="v">{{ o.value }}</div>{% endif %}</div>{% endfor %}</div>{% endif %}
  {% if s.left and s.right %}<div class="cols card">{% for c in [s.left, s.right] %}<div class="col"><div class="lab">{{ c.label }}</div>{% if c.value %}<div class="val">{{ c.value }}</div>{% endif %}{% if c.note %}<div class="txt">{{ c.note|md }}</div>{% endif %}</div>{% endfor %}</div>{% endif %}
  {% if s.ticket %}<div class="ticket card">{% if s.ticket.label %}<div class="fict">{{ s.ticket.label }}</div>{% endif %}{% for r in s.ticket.rows %}<div class="row{% if r[2] is defined and r[2] %} {{ r[2] }}{% endif %}"><span>{{ r[0] }}</span><span>{{ r[1] }}</span></div>{% endfor %}</div>{% endif %}
  {% if s.steps %}<ol class="steps">{% for it in s.steps %}<li class="card"><span class="n">{{ loop.index }}</span><span class="t">{{ it.title|md }}{% if it.sub %}<span>{{ it.sub|md }}</span>{% endif %}</span></li>{% endfor %}</ol>{% endif %}
  {% if s.note %}<div class="note">{{ s.note|md }}</div>{% endif %}
  {% if s.source %}<div class="source"><b>Source</b> · {{ s.source }}</div>{% endif %}
  {% if s.next %}<div class="next">{{ s.next|md }}</div>{% endif %}
{% endif %}
</main>

<footer>
  <div class="mono"><div class="ring"><img src="../assets/logo-emblem.webp" alt=""></div>{% if s.type == "cta" %}<span class="w">VALORISLAB</span>{% endif %}</div>
  {% if s.type not in ["cover", "hook"] %}<span class="disclaimer">Contenu éducatif, pas un conseil financier</span>{% endif %}
</footer>

<script>
window.__fit = async () => {
  await document.fonts.ready;
  await Promise.all([...document.images].map(im => im.complete ? 1 : new Promise(r => { im.onload = im.onerror = r; })));
  const m = document.getElementById('main');
  let s = 1;
  const root = document.documentElement;
  root.style.setProperty('--s', s);
  const wide = () => [...document.querySelectorAll('.big,.cols .val,.opt .v,.stamp,.cta-btn')].some(e => e.getBoundingClientRect().right > m.getBoundingClientRect().right + 1);
  const over = () => m.scrollHeight > m.clientHeight + 1 || m.scrollWidth > m.clientWidth + 1 || wide();
  while (over() && s > 0.6) { s = +(s - 0.02).toFixed(2); root.style.setProperty('--s', s); }
  const t = document.querySelector('.title');
  const lines = t ? Math.round(t.getBoundingClientRect().height / parseFloat(getComputedStyle(t).lineHeight)) : 0;
  return {scale: s, overflow: over(), title_lines: lines};
};
</script>
</body>
</html>
