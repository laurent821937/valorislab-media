<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<style>
{% for w in [400,500,600,700,800] %}
@font-face{font-family:"Inter";src:url("../fonts/inter-latin-{{ w }}-normal.woff2") format("woff2");font-weight:{{ w }};unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:"Inter";src:url("../fonts/inter-latin-ext-{{ w }}-normal.woff2") format("woff2");font-weight:{{ w }};unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}
{% endfor %}
{% for w in [500,600,700] %}{% for st in ["normal","italic"] %}
@font-face{font-family:"Playfair";src:url("../fonts/playfair-display-latin-{{ w }}-{{ st }}.woff2") format("woff2");font-weight:{{ w }};font-style:{{ st }};unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:"Playfair";src:url("../fonts/playfair-display-latin-ext-{{ w }}-{{ st }}.woff2") format("woff2");font-weight:{{ w }};font-style:{{ st }};unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}
{% endfor %}{% endfor %}
/* Charte v6 premium (20/11/2026) : docs/STYLE-CARROUSEL.md ; brief docs/brief-refonte-carrousels-2026-11.md (sections 4 et 5).
   Titres en Playfair Display (éditorial), texte en Inter, filets or fins, cadre intérieur, couverture pleine image. */
:root{
  --W:{{ W }}px; --H:{{ H }}px; --s:1; --u:calc(1px * var(--s));
{% if bg == "light" %}
  --bg:#F3EEE4; --bg2:#ECE5D8; --ink:#1F1D1A; --body:#34302A; --sub:#5E574D; --acc:#89692F; --acc-t:#7A5C26; --hair:rgba(137,105,47,.35);
  --card:#FBF8F2; --card-line:rgba(137,105,47,.28); --card-ink:#1F1D1A; --card-sub:#5E574D; --card-acc:#7A5C26;
  --bubble:#FBF8F2; --bubble-ink:#1F1D1A; --me:#1F1D1A; --me-ink:#F3EEE4; --ring-bg:#1F1D1A; --on-acc:#FBF8F2;
{% else %}
  --bg:#121214; --bg2:#1A1816; --ink:#F6F2EA; --body:#DDD7CC; --sub:#ADA69B; --acc:#E2BE7C; --acc-t:#E2BE7C; --hair:rgba(226,190,124,.38);
  --card:#F3EEE4; --card-line:rgba(217,203,176,.9); --card-ink:#1C1A17; --card-sub:#5E574D; --card-acc:#7A5C26;
  --bubble:#212124; --bubble-ink:#F6F2EA; --me:#E2BE7C; --me-ink:#1A1612; --ring-bg:#0C0B0A; --on-acc:#1A1612;
{% endif %}
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{width:var(--W);height:var(--H);overflow:hidden;background:var(--bg)}
body{position:relative;color:var(--ink);font-family:"Inter",system-ui,sans-serif;-webkit-font-smoothing:antialiased;text-rendering:geometricPrecision;font-feature-settings:"ss01","cv11"}
{% if bg == "light" %}
.glow{position:absolute;inset:0;pointer-events:none;background:radial-gradient(900px 760px at {{ halo_x }}% {{ halo_y }}%, rgba(255,255,255,.85), rgba(255,255,255,0) 72%),linear-gradient(180deg,var(--bg) 0,var(--bg2) 100%)}
{% else %}
.glow{position:absolute;inset:0;pointer-events:none;background:radial-gradient(820px 680px at {{ halo_x }}% {{ halo_y }}%, rgba(110,84,56,.34), rgba(60,46,34,.12) 55%, transparent 80%),linear-gradient(180deg,#141416 0,#0F0F11 100%)}
{% endif %}
/* fine inner frame (magazine) */
.frame{position:absolute;z-index:4;left:36px;right:36px;top:36px;bottom:166px;border:1px solid var(--hair);border-radius:4px;pointer-events:none}

/* --- frame elements: format tag (top left), counter (top right), monogram (bottom left); nothing below y 1190 (TikTok) */
.tag{position:absolute;z-index:6;left:72px;top:72px;display:flex;align-items:center;gap:14px;
  font-weight:600;font-size:22px;letter-spacing:.24em;text-transform:uppercase;color:var(--acc-t);white-space:nowrap}
.tag::before{content:"";width:34px;height:1px;background:var(--acc)}
.count{position:absolute;z-index:6;right:72px;top:68px;font-family:"Playfair";font-style:italic;font-weight:500;font-size:30px;color:var(--sub);font-variant-numeric:lining-nums}
footer{position:absolute;z-index:6;left:72px;right:72px;top:1104px;height:56px;display:flex;align-items:center;justify-content:space-between}
.mono{display:flex;align-items:center;gap:14px}
.mono .ring{width:50px;height:50px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--ring-bg);border:1px solid rgba(201,169,110,.75)}
.mono .ring img{width:34px;height:auto}
.mono .w{font-weight:600;font-size:18px;letter-spacing:.34em;color:var(--ink)}
footer .disclaimer{font-size:18px;letter-spacing:.04em;color:var(--sub)}

/* --- content */
main{position:absolute;z-index:5;left:84px;right:112px;top:170px;bottom:262px;display:flex;flex-direction:column;overflow:hidden}
main > :first-child{margin-top:auto}
em{font-style:italic;color:var(--acc)}
strong{font-weight:700}
.kicker{display:flex;align-items:center;gap:16px;font-weight:600;font-size:calc(22 * var(--u));letter-spacing:.24em;text-transform:uppercase;color:var(--acc-t);margin-bottom:calc(30 * var(--u))}
.kicker::before{content:"";width:28px;height:1px;background:var(--acc)}
.title{font-family:"Playfair";font-weight:600;font-size:calc(80 * var(--u));line-height:1.08;letter-spacing:-.012em;color:var(--ink)}
.title em{font-weight:600}
.body{font-weight:400;font-size:calc(40 * var(--u));line-height:1.45;color:var(--body);margin-top:calc(34 * var(--u))}
.note,.source{font-size:calc(24 * var(--u));line-height:1.45;color:var(--sub);margin-top:calc(26 * var(--u))}
.source b{color:var(--acc-t);font-weight:600;letter-spacing:.08em;text-transform:uppercase;font-size:.9em}
.next{margin-top:auto;padding-top:calc(30 * var(--u));display:flex;align-items:center;gap:18px;font-weight:600;font-size:calc(30 * var(--u));letter-spacing:.14em;text-transform:uppercase;color:var(--acc-t)}
.next::after{content:"";flex:0 0 70px;height:1px;background:var(--acc);margin-left:6px}
.next::before{content:"";display:none}
.big{font-family:"Playfair";font-weight:600;font-size:calc(200 * var(--u));line-height:.95;letter-spacing:-.02em;color:var(--acc);margin-top:calc(20 * var(--u));white-space:nowrap;font-variant-numeric:lining-nums}
.big-lab{font-weight:500;font-size:calc(36 * var(--u));line-height:1.35;color:var(--ink);margin-top:calc(22 * var(--u));padding-top:calc(22 * var(--u));border-top:1px solid var(--hair)}

/* cards */
.card{background:var(--card);border:1px solid var(--card-line);border-radius:18px;color:var(--card-ink);box-shadow:0 24px 60px rgba(0,0,0,{{ ".08" if bg == "light" else ".38" }})}
.opts{display:flex;flex-direction:column;gap:calc(16 * var(--u));margin-top:calc(38 * var(--u))}
.opt{display:flex;align-items:center;gap:calc(28 * var(--u));padding:calc(24 * var(--u)) calc(32 * var(--u))}
.opt .l{flex:0 0 auto;width:calc(76 * var(--u));height:calc(76 * var(--u));border-radius:50%;display:flex;align-items:center;justify-content:center;
  border:1.5px solid var(--card-acc);color:var(--card-acc);font-family:"Playfair";font-style:italic;font-weight:600;font-size:calc(40 * var(--u))}
.opt .t b{display:block;font-weight:600;font-size:calc(38 * var(--u));line-height:1.2;color:var(--card-ink)}
.opt .t span{display:block;font-size:calc(30 * var(--u));line-height:1.3;color:var(--card-sub);margin-top:calc(4 * var(--u))}
.opt .v{margin-left:auto;font-family:"Playfair";font-weight:600;font-size:calc(46 * var(--u));color:var(--card-acc);white-space:nowrap;font-variant-numeric:lining-nums}
.opt.out{background:#D9D2C5;border-color:#C9BEAB;box-shadow:none}
.opt.out .v{text-decoration:line-through;text-decoration-thickness:2px}
.opt.win{outline:3px solid var(--acc);outline-offset:5px}

.cols{display:grid;grid-template-columns:1fr 1fr;margin-top:calc(38 * var(--u));padding:calc(34 * var(--u)) 0}
.cols .col{padding:0 calc(34 * var(--u));min-width:0}
.cols .col+.col{border-left:1px solid rgba(122,92,38,.3)}
.cols .lab{font-weight:600;font-size:calc(22 * var(--u));text-transform:uppercase;letter-spacing:.16em;color:var(--card-sub)}
.cols .val{font-family:"Playfair";font-weight:600;font-size:calc(104 * var(--u));line-height:1.05;color:var(--card-ink);margin-top:calc(18 * var(--u));white-space:nowrap;font-variant-numeric:lining-nums}
.cols .col:first-child .val{color:var(--card-acc)}
.cols .txt{font-size:calc(30 * var(--u));line-height:1.35;color:var(--card-ink);margin-top:calc(12 * var(--u))}

ol.steps{list-style:none;margin-top:calc(38 * var(--u));display:flex;flex-direction:column;gap:calc(16 * var(--u))}
ol.steps li{display:flex;align-items:center;gap:calc(26 * var(--u));padding:calc(22 * var(--u)) calc(30 * var(--u))}
ol.steps .n{flex:0 0 auto;font-family:"Playfair";font-style:italic;font-weight:600;font-size:calc(44 * var(--u));color:var(--card-acc)}
ol.steps .t{font-size:calc(34 * var(--u));line-height:1.3;color:var(--card-ink)}
ol.steps .t span{display:block;font-size:calc(30 * var(--u));color:var(--card-sub)}

/* chat (F7) */
.chat{display:flex;flex-direction:column;gap:calc(20 * var(--u));margin-top:calc(36 * var(--u))}
.msg{max-width:86%;padding:calc(26 * var(--u)) calc(34 * var(--u));border-radius:34px;font-size:calc(40 * var(--u));line-height:1.32;font-weight:400}
.msg.them{align-self:flex-start;background:var(--bubble);color:var(--bubble-ink);border-bottom-left-radius:8px;border:1px solid {{ "var(--card-line)" if bg == "light" else "rgba(255,255,255,.09)" }}}
.msg.me{align-self:flex-end;background:var(--me);color:var(--me-ink);border-bottom-right-radius:8px;font-weight:500}
.msg.flag{box-shadow:0 0 0 3px var(--acc),0 0 0 9px rgba(226,190,124,.14)}
.flagnote{align-self:flex-start;display:inline-flex;align-items:center;gap:12px;padding:calc(8 * var(--u)) calc(18 * var(--u));border-radius:8px;background:var(--acc);
  color:var(--on-acc);font-weight:700;font-size:calc(24 * var(--u));text-transform:uppercase;letter-spacing:.1em;margin-top:calc(-2 * var(--u))}
.who{font-size:calc(22 * var(--u));color:var(--sub);font-weight:600;letter-spacing:.2em;text-transform:uppercase}

/* stamp (F2) */
.stamp{display:inline-block;align-self:flex-start;transform:rotate(-6deg);padding:calc(14 * var(--u)) calc(36 * var(--u));border:calc(6 * var(--u)) double var(--acc);border-radius:10px;
  font-weight:800;font-size:calc(72 * var(--u));letter-spacing:.14em;text-transform:uppercase;color:var(--acc);line-height:1;white-space:nowrap}
.stamp.huge{font-size:calc(140 * var(--u));margin:calc(20 * var(--u)) 0 calc(36 * var(--u)) calc(10 * var(--u))}

/* receipt (F6) */
.ticket{align-self:flex-start;width:100%;padding:calc(30 * var(--u)) calc(36 * var(--u));font-variant-numeric:tabular-nums;margin-top:calc(30 * var(--u))}
.ticket .row{display:flex;justify-content:space-between;gap:24px;font-size:calc(34 * var(--u));line-height:1.5;color:var(--card-ink)}
.ticket .row.new{color:var(--card-acc);font-weight:700}
.ticket .row.total{border-top:2px dashed var(--card-line);margin-top:calc(12 * var(--u));padding-top:calc(12 * var(--u));font-weight:700;font-size:calc(42 * var(--u))}
.fict{font-size:calc(22 * var(--u));font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--card-sub);margin-bottom:calc(8 * var(--u))}

/* --- cover */
.t-cover main,.t-hook main{top:{{ 500 if visual == "photo" else (520 if visual == "face" else 170) }}px;bottom:262px}
.t-cover main > :last-child,.t-hook main > :last-child{margin-bottom:0}
.t-cover main > .stamp:last-child,.t-hook main > .stamp:last-child{margin-bottom:calc(36 * var(--u))}
.t-cover .title,.t-hook .title{font-size:calc(112 * var(--u));line-height:1.02;letter-spacing:-.02em}
.t-cover .big,.t-hook .big{font-size:calc(210 * var(--u));margin:0 0 calc(8 * var(--u))}
.t-cover .sub,.t-hook .sub{font-weight:500;font-size:calc(30 * var(--u));letter-spacing:.16em;text-transform:uppercase;color:var(--sub);margin-top:calc(30 * var(--u))}
.t-cover .msg,.t-hook .msg{font-size:calc(40 * var(--u));margin-bottom:calc(34 * var(--u))}
.t-cover .stamp,.t-hook .stamp{margin-top:calc(44 * var(--u));margin-bottom:calc(14 * var(--u));margin-left:calc(8 * var(--u))}
.t-cover .quote,.t-hook .quote{font-family:"Playfair";font-style:italic;font-weight:600;font-size:calc(160 * var(--u));line-height:1;color:var(--acc);height:calc(96 * var(--u))}
{% if visual in ["photo", "face"] %}
.photo{position:absolute;left:0;right:0;top:0;height:{{ 1350 if visual == "photo" else 600 }}px;z-index:1;overflow:hidden}
.photo img{width:100%;height:100%;object-fit:cover;object-position:{{ photo_pos }};filter:{{ "saturate(.95)" if bg == "light" else "saturate(.88) contrast(1.03)" }}}
.shade{position:absolute;left:0;right:0;top:0;bottom:0;z-index:2;pointer-events:none;
{% if visual == "photo" %}
  background:linear-gradient(180deg,rgba({{ "243,238,228" if bg == "light" else "14,14,16" }},.55) 0,rgba({{ "243,238,228" if bg == "light" else "14,14,16" }},0) 14%,rgba({{ "243,238,228" if bg == "light" else "14,14,16" }},0) 34%,rgba({{ "243,238,228" if bg == "light" else "14,14,16" }},.82) 52%,var(--bg) 68%,var(--bg) 100%)}
{% else %}
  height:600px;background:linear-gradient(180deg,transparent 60%,var(--bg) 100%)}
{% endif %}
.t-cover .frame,.t-hook .frame{border-color:{{ "rgba(137,105,47,.35)" if bg == "light" else "rgba(226,190,124,.32)" }}}
{% endif %}

/* --- last slide (guide) */
.t-cta main > :last-child{margin-bottom:auto}
.t-cta .title{font-size:calc(86 * var(--u))}
.t-cta .body{font-size:calc(40 * var(--u))}
.cta-row{display:flex;align-items:center;gap:calc(40 * var(--u));margin-top:calc(46 * var(--u))}
.mock{flex:0 0 auto;width:calc(300 * var(--u));height:calc(300 * var(--u));border-radius:14px;overflow:hidden;box-shadow:0 30px 60px rgba(0,0,0,.45);border:1px solid var(--hair)}
.mock img{width:100%;height:100%;object-fit:cover}
.cta-btn{align-self:flex-start;padding:calc(22 * var(--u)) calc(40 * var(--u));border-radius:999px;background:var(--acc);
  color:var(--on-acc);font-weight:700;font-size:calc(32 * var(--u));letter-spacing:.08em;text-transform:uppercase}
.url{font-family:"Playfair";font-style:italic;font-weight:500;font-size:calc(40 * var(--u));color:var(--ink);margin-top:calc(26 * var(--u))}
</style>
</head>
<body class="t-{{ s.type }} bg-{{ bg }}">
<div class="glow"></div>
{% if visual in ["photo", "face"] and s.type in ["cover", "hook"] %}<div class="photo"><img src="{{ photo_src }}" alt=""></div><div class="shade"></div>{% endif %}
<div class="frame"></div>
{% if tag %}<div class="tag">{{ tag }}</div>{% endif %}
{% if s.type != "hook" %}<div class="count">{{ i }}/{{ n }}</div>{% endif %}

<main id="main">
{% if s.type in ["cover", "hook"] %}
  {% set v = s.visual or {} %}
  {% if v.type == "bubble" or v.bubble %}<div class="msg them">{{ (v.text if v.type == "bubble" else v.bubble)|md }}</div>{% endif %}
  {% if v.type == "ticket" %}<div class="ticket card"><div class="fict">{{ v.label or "Exemple fictif" }}</div>{% for r in v.rows %}<div class="row{% if loop.last %} total{% endif %}"><span>{{ r[0] }}</span><span>{{ r[1] }}</span></div>{% endfor %}</div>{% endif %}
  {% if (v.type == "stamp" or v.stamp) and visual != "photo" %}<div class="quote">«</div>{% endif %}
  {% if s.number %}<div class="big">{{ s.number }}</div>{% endif %}
  <div class="title">{{ s.title|md }}</div>
  {% if s.subtitle %}<div class="sub">{{ s.subtitle|md }}</div>{% endif %}
  {% if v.type == "stamp" or v.stamp %}<div class="stamp">{{ v.text if v.type == "stamp" else v.stamp }}</div>{% endif %}
  {% if v.type in ["dossier", "document"] or v.fiction %}<div class="note" style="font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--acc-t)">{{ v.fiction or v.text or ("Cas fictif" if v.type == "dossier" else "Document fictif") }}</div>{% endif %}

{% elif s.type == "cta" %}
  <div class="kicker">{{ s.kicker or "Le guide gratuit" }}</div>
  <div class="title">{{ s.title|md }}</div>
  <div class="body">{{ s.body|md }}</div>
  <div class="cta-row">{% if guide_mockup %}<div class="mock"><img src="{{ guide_mockup }}" alt=""></div>{% endif %}
    <div><div class="cta-btn">{{ s.button or "Lien dans ma bio" }}</div><div class="url">valorislab.be</div></div></div>

{% else %}
  {% if s.kicker %}<div class="kicker">{{ s.kicker }}</div>{% endif %}
  {% if s.type == "verdict" %}<div class="stamp huge">{{ s.stamp }}</div>{% endif %}
  {% if s.title %}<div class="title">{{ s.title|md }}</div>{% endif %}
  {% if s.type == "chat" %}
  {% if s.who %}<div class="who" style="margin-top:calc(22 * var(--u))">{{ s.who }}</div>{% endif %}
  <div class="chat">{% for m in s.messages %}<div class="msg {{ m.from or 'them' }}{% if m.flag %} flag{% endif %}">{{ m.text|md }}</div>{% if m.flag %}<div class="flagnote">{{ m.flag }}</div>{% endif %}{% endfor %}</div>
  {% endif %}
  {% if s.body %}<div class="body">{{ s.body|md }}</div>{% endif %}
  {% if s.big %}<div class="big">{{ s.big.value }}</div>{% if s.big.label %}<div class="big-lab">{{ s.big.label|md }}</div>{% endif %}{% endif %}
  {% if s.options %}<div class="opts">{% for o in s.options %}<div class="opt card{% if o.state == 'out' %} out{% endif %}{% if o.state == 'win' %} win{% endif %}"><div class="l">{{ o.letter }}</div><div class="t"><b>{{ o.label|md }}</b>{% if o.detail %}<span>{{ o.detail|md }}</span>{% endif %}</div>{% if o.value %}<div class="v">{{ o.value }}</div>{% endif %}</div>{% endfor %}</div>{% endif %}
  {% if s.left and s.right %}<div class="cols card">{% for c in [s.left, s.right] %}<div class="col"><div class="lab">{{ c.label }}</div>{% if c.value %}<div class="val">{{ c.value }}</div>{% endif %}{% if c.note %}<div class="txt">{{ c.note|md }}</div>{% endif %}</div>{% endfor %}</div>{% endif %}
  {% if s.ticket %}<div class="ticket card">{% if s.ticket.label %}<div class="fict">{{ s.ticket.label }}</div>{% endif %}{% for r in s.ticket.rows %}<div class="row{% if r[2] is defined and r[2] %} {{ r[2] }}{% endif %}"><span>{{ r[0] }}</span><span>{{ r[1] }}</span></div>{% endfor %}</div>{% endif %}
  {% if s.steps %}<ol class="steps">{% for it in s.steps %}<li class="card"><span class="n">{{ loop.index }}</span><span class="t">{{ it.title|md }}{% if it.sub %}<span>{{ it.sub|md }}</span>{% endif %}</span></li>{% endfor %}</ol>{% endif %}
  {% if s.note %}<div class="note">{{ s.note|md }}</div>{% endif %}
  {% if s.source %}<div class="source"><b>Source</b> · {{ s.source }}</div>{% endif %}
  {% if s.next %}<div class="next">{{ s.next|md }}</div>{% endif %}
{% endif %}
</main>

<footer>
  <div class="mono"><div class="ring"><img src="../assets/logo-emblem.webp" alt=""></div><span class="w">VALORISLAB</span></div>
  {% if s.type not in ["cover", "hook"] %}<span class="disclaimer">Contenu éducatif, pas un conseil financier</span>{% endif %}
</footer>

<script>
window.__fit = async () => {
  await document.fonts.ready;
  await Promise.all([...document.images].map(im => im.complete ? 1 : new Promise(r => { im.onload = im.onerror = r; })));
  const m = document.getElementById('main');
  let s = 1;
  const root = document.documentElement;
  root.style.setProperty('--s', s);
  const wide = () => [...document.querySelectorAll('.big,.cols .val,.opt .v,.stamp,.cta-btn')].some(e => e.getBoundingClientRect().right > m.getBoundingClientRect().right + 1);
  const over = () => m.scrollHeight > m.clientHeight + 1 || m.scrollWidth > m.clientWidth + 1 || wide();
  while (over() && s > 0.6) { s = +(s - 0.02).toFixed(2); root.style.setProperty('--s', s); }
  const t = document.querySelector('.title');
  const lines = t ? Math.round(t.getBoundingClientRect().height / parseFloat(getComputedStyle(t).lineHeight)) : 0;
  return {scale: s, overflow: over(), title_lines: lines};
};
</script>
</body>
</html>
