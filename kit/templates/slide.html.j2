<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<style>
{% for w in [400,500,600,700,800] %}
@font-face{font-family:"Inter";src:url("../fonts/inter-latin-{{ w }}-normal.woff2") format("woff2");font-weight:{{ w }};unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:"Inter";src:url("../fonts/inter-latin-ext-{{ w }}-normal.woff2") format("woff2");font-weight:{{ w }};unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}
{% endfor %}
/* Charte v5 (docs/STYLE-CARROUSEL.md, modèle kit/assets/references/carrousel-v5/) */
:root{
  --W:{{ W }}px; --H:{{ H }}px;
  --bg:#141416; --ink:#F6F2EA; --body:#E2DDD4; --sub:#C9C3B9; --muted:#B0AAA1;
  --gold:#E5C07B; --gold-k:#D4AF6A; --line:#B8975A; --card:#151516;
  /* encadrés ivoire (demande de Laurent, 06/11/2026) */
  --ivory:#F3EEE4; --ivory-line:#D9CBB0; --ivory-ink:#1C1A17; --ivory-sub:#5E574D; --ivory-gold:#8A6A2E;
  --s:1; --u:calc(1px * var(--s));
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{width:var(--W);height:var(--H);overflow:hidden;background:var(--bg)}
body{position:relative;color:var(--ink);font-family:"Inter",system-ui,sans-serif;-webkit-font-smoothing:antialiased;text-rendering:geometricPrecision}

/* background: warm glow + architectural grid (220 px, from x 96 / y 180) */
.glow{position:absolute;inset:0;pointer-events:none;
  background:radial-gradient(760px 640px at {{ halo_x }}% {{ halo_y }}%, rgba(92,72,52,.42), rgba(58,46,36,.18) 55%, transparent 80%)}
.grid{position:absolute;inset:0;z-index:3;pointer-events:none;
  background-image:linear-gradient(90deg,rgba(255,255,255,.06) 1px,transparent 1px),linear-gradient(180deg,rgba(255,255,255,.06) 1px,transparent 1px);
  background-size:220px 220px;background-position:96px 180px}

/* --- fixed frame */
.brand{position:absolute;z-index:6;left:100px;top:214px;display:flex;align-items:center;gap:16px}
.brand .ring{width:52px;height:52px;border-radius:50%;display:flex;align-items:center;justify-content:center;
  background:radial-gradient(circle at 50% 40%,#1c1915,#0c0b0a);border:1.5px solid rgba(201,169,110,.55)}
.brand .ring img{width:38px;height:auto}
.brand .t1{color:var(--ink);font-weight:500;font-size:21px;letter-spacing:.32em;line-height:1}
.brand .t2{color:var(--gold-k);font-weight:500;font-size:13px;letter-spacing:.24em;line-height:1;margin-top:9px}
.count{position:absolute;z-index:6;right:100px;top:226px;font-weight:500;font-size:26px;letter-spacing:.02em;color:var(--muted);font-variant-numeric:tabular-nums}
footer{position:absolute;z-index:6;left:96px;right:96px;top:1084px;padding-top:18px;border-top:1.5px solid rgba(201,169,110,.75);
  display:flex;align-items:baseline;justify-content:space-between}
footer .url{font-weight:400;font-size:22px;color:var(--muted)}
footer .disclaimer{font-size:18px;color:var(--muted)}

/* --- content area: y 290 to 1060 (nothing below the footer rule: TikTok caption zone) */
main{position:absolute;z-index:5;left:96px;right:100px;top:290px;bottom:290px;display:flex;flex-direction:column;justify-content:flex-start;overflow:hidden}
.has-fig main{right:auto;width:{{ col_w }}px}

/* --- type */
.kicker{display:flex;align-items:center;gap:16px;font-weight:600;font-size:calc(23 * var(--u));letter-spacing:.01em;text-transform:uppercase;color:var(--gold-k);margin-bottom:calc(48 * var(--u))}
.kicker::before{content:"";flex:0 0 42px;height:2px;background:var(--gold-k)}
.title{max-width:700px;font-weight:700;font-size:calc(64 * var(--u));line-height:1.13;letter-spacing:-.01em;text-transform:uppercase;color:var(--ink)}
.title em{font-style:normal;color:var(--gold)}
em{font-style:normal;color:var(--gold)}
strong{font-weight:600;color:var(--ink)}
.lead,.body{max-width:700px;font-weight:400;font-size:calc(33 * var(--u));line-height:1.52;color:var(--body);margin-top:calc(54 * var(--u))}
.body p+p{margin-top:calc(18 * var(--u))}
.hl{font-weight:500;font-size:calc(24 * var(--u));line-height:1.45;color:var(--gold-k);margin-top:calc(46 * var(--u))}
.note,.source{font-size:calc(21 * var(--u));line-height:1.45;color:var(--muted);margin-top:calc(26 * var(--u))}
.source b{font-weight:600;color:var(--gold-k)}

/* gold-bordered card, two columns */
.card{border:1.5px solid var(--line);border-radius:22px;background:var(--card);margin-top:calc(44 * var(--u));padding:calc(30 * var(--u)) 0}
.card .cols{display:grid;grid-template-columns:1fr 1fr}
.card .col{padding:0 calc(30 * var(--u));min-width:0}
.card .col + .col{border-left:1.5px solid var(--line)}
.card .lab{font-weight:600;font-size:calc(24 * var(--u));letter-spacing:.01em;text-transform:uppercase;color:var(--gold-k)}
.card .lab.grey{color:var(--sub)}
.card .txt{font-size:calc(28 * var(--u));line-height:1.4;color:var(--ink);margin-top:calc(14 * var(--u))}
.card .val{font-weight:700;font-size:calc(76 * var(--u));line-height:1.05;letter-spacing:-.01em;color:var(--ink);margin-top:calc(26 * var(--u));white-space:nowrap}
.card .col:first-child .val{color:var(--gold-k)}
.card .val.win{color:var(--gold)}
.card .cap{font-size:calc(26 * var(--u));line-height:1.4;color:var(--ink);padding:calc(24 * var(--u)) calc(30 * var(--u)) 0;margin-top:calc(26 * var(--u));border-top:1.5px solid rgba(184,151,90,.35)}
.card.single{padding:calc(26 * var(--u)) calc(30 * var(--u));font-size:calc(28 * var(--u));line-height:1.4;color:var(--body)}
.big{font-weight:700;font-size:calc(150 * var(--u));line-height:1;letter-spacing:-.03em;color:var(--gold);margin-top:calc(40 * var(--u));white-space:nowrap}
.big .unit{font-size:.4em;color:var(--ink);margin-left:.2em;letter-spacing:0}
.big-lab{font-size:calc(28 * var(--u));line-height:1.4;color:var(--ink);margin-top:calc(12 * var(--u))}

/* numbered boxes (method / recap) */
ol.steps{list-style:none;margin-top:calc(44 * var(--u));display:flex;flex-direction:column;gap:calc(14 * var(--u))}
ol.steps li{display:flex;align-items:center;border:1.5px solid var(--line);border-radius:18px;background:var(--card);padding:calc(16 * var(--u)) 0;min-height:calc(100 * var(--u))}
ol.steps .n{flex:0 0 102px;align-self:stretch;display:flex;align-items:center;padding-left:28px;border-right:1.5px solid var(--line);
  font-weight:600;font-size:calc(32 * var(--u));color:var(--gold-k);font-variant-numeric:tabular-nums}
ol.steps .t{padding:0 calc(26 * var(--u));font-size:calc(30 * var(--u));line-height:1.3}
ol.steps .t b{display:block;font-weight:500;color:var(--ink)}
ol.steps .t span{display:block;color:var(--sub)}

/* box list (charte v4 content) */
.box{border:1.5px solid var(--line);border-radius:22px;background:var(--card);padding:calc(28 * var(--u)) calc(30 * var(--u));margin-top:calc(40 * var(--u))}
.box .h{font-weight:600;font-size:calc(22 * var(--u));text-transform:uppercase;color:var(--gold-k);margin-bottom:calc(6 * var(--u))}
.box li{list-style:none;display:flex;gap:12px;font-size:calc(28 * var(--u));line-height:1.35;color:var(--ink);margin-top:calc(12 * var(--u))}
.box li::before{content:"→";color:var(--gold-k)}

/* split bar (charte v4 content) */
.split{display:flex;height:calc(92 * var(--u));border:1.5px solid var(--line);border-radius:18px;overflow:hidden;margin-top:calc(44 * var(--u))}
.split > div{display:flex;flex-direction:column;justify-content:center;padding:0 calc(24 * var(--u));min-width:0;background:var(--card)}
.split .r{background:var(--gold);color:#1A1612}
.split .v{font-weight:700;font-size:calc(32 * var(--u));white-space:nowrap}
.split .k{font-size:calc(18 * var(--u));color:var(--sub);white-space:nowrap}
.split .r .k{color:#3A3122}

/* --- encadrés ivoire : fond clair, texte sombre, accents or foncé */
.card,.box,ol.steps li,.split{background:var(--ivory);border-color:var(--ivory-line);box-shadow:0 18px 40px rgba(0,0,0,.35)}
.split > div{background:var(--ivory)}
.split .r{background:var(--gold)}
.card .col + .col,ol.steps .n{border-color:rgba(138,106,46,.35)}
.card .lab,.box .h,ol.steps .n,.box li::before{color:var(--ivory-gold)}
.card .lab.grey,.split .k{color:var(--ivory-sub)}
.card .txt,.card .val,.card .cap,.box li,ol.steps .t,ol.steps .t b,.split .v{color:var(--ivory-ink)}
.card .col:first-child .val,.card .val.win{color:var(--ivory-gold)}
.card.single,ol.steps .t span{color:var(--ivory-sub)}
.card .cap{border-top-color:rgba(138,106,46,.3)}
.card strong,.box strong,ol.steps strong{color:var(--ivory-ink)}
.card em,.box em,ol.steps em{color:var(--ivory-gold)}

/* --- cover / Facebook hook: AI decor in the lower part, under the grid */
{% if scene %}
.scene{position:absolute;left:0;right:0;bottom:0;z-index:1;height:{{ scene.h }}px;overflow:hidden;
  -webkit-mask-image:linear-gradient(180deg,transparent 0,#000 42%,#000 100%);mask-image:linear-gradient(180deg,transparent 0,#000 42%,#000 100%)}
.scene img{display:block;width:100%;height:100%;object-fit:cover;object-position:{{ scene.pos }};filter:saturate(.6) contrast(1.03) brightness(.92)}
.scene-shade{position:absolute;left:0;right:0;bottom:0;z-index:2;height:{{ scene.h }}px;
  background:linear-gradient(180deg,var(--bg) 0,rgba(20,20,22,.55) 35%,rgba(20,20,22,.3) 55%,rgba(20,20,22,.72) 68%,rgba(20,20,22,.92) 82%,var(--bg) 100%),
             linear-gradient(90deg,rgba(20,20,22,.55) 0,transparent 55%)}
{% if scene.hide_header %}.brand{visibility:hidden}{% endif %}
{% endif %}
.t-cover .title{max-width:700px;font-size:calc(74 * var(--u));line-height:1.1}
.t-cover .lead{max-width:620px;margin-top:calc(70 * var(--u))}
.t-cover .lead,.t-cover .hl,.t-hook .lead{text-shadow:0 2px 14px rgba(0,0,0,.85)}
.t-hook .title{max-width:860px;font-size:calc(92 * var(--u));line-height:1.07}
.t-hook .lead{font-size:calc(36 * var(--u))}

/* --- cta */
.t-cta .title{max-width:600px;font-size:calc(70 * var(--u))}
.t-cta .lead{margin-top:calc(26 * var(--u));font-size:calc(32 * var(--u))}
.mock{position:relative;flex:1 1 auto;min-height:calc(300 * var(--u));margin-top:calc(16 * var(--u))}
.mock img{position:absolute;left:50%;top:0;bottom:calc(46 * var(--u));transform:translateX(-50%);height:calc(100% - 46 * var(--u));width:auto;max-width:100%;object-fit:contain;
  -webkit-mask-image:linear-gradient(90deg,transparent 0,#000 7%,#000 93%,transparent 100%),linear-gradient(180deg,transparent 0,#000 6%,#000 90%,transparent 100%);
  -webkit-mask-composite:source-in;mask-image:linear-gradient(90deg,transparent 0,#000 7%,#000 93%,transparent 100%),linear-gradient(180deg,transparent 0,#000 6%,#000 90%,transparent 100%);mask-composite:intersect}
.cta-btn{position:absolute;left:50%;bottom:0;transform:translateX(-50%);display:inline-flex;align-items:center;gap:26px;white-space:nowrap;
  padding:calc(20 * var(--u)) calc(70 * var(--u));border-radius:16px;background:#E3BE78;color:#1A1612;
  font-weight:700;font-size:calc(42 * var(--u));letter-spacing:.01em;text-transform:uppercase;box-shadow:0 18px 50px rgba(0,0,0,.55)}

{% if fig %}
.fig{position:absolute;z-index:4;bottom:{{ fig.bottom }}px;{{ fig.side }}:{{ fig.offset }}px;width:{{ fig.w }}px;height:{{ fig.vis_h }}px;overflow:hidden;
  -webkit-mask-image:linear-gradient(180deg,#000 0,#000 {{ fig.fade_from }}%,transparent 100%);mask-image:linear-gradient(180deg,#000 0,#000 {{ fig.fade_from }}%,transparent 100%)}
.fig .hero{position:absolute;top:{{ fig.top_pad }}px;left:0;height:{{ fig.full_h }}px;width:{{ fig.w }}px;{% if fig.mirror %}transform:scaleX(-1);{% endif %}filter:sepia(.15) brightness(.96)}
{% endif %}
</style>
</head>
<body class="t-{{ s.type }} theme-{{ theme }}{% if fig %} has-fig{% endif %}{% if scene %} has-scene{% endif %}">
<div class="glow"></div>
{% if scene %}<div class="scene"><img src="{{ scene.src }}" alt=""></div><div class="scene-shade"></div>{% endif %}
<div class="grid"></div>
{% if fig %}<div class="fig"><img class="hero" src="{{ fig.src }}" alt=""></div>{% endif %}

<div class="brand"><div class="ring"><img src="../assets/logo-emblem.webp" alt=""></div><div><div class="t1">VALORISLAB</div><div class="t2">FINANCE BELGIQUE</div></div></div>
{% if s.type != "hook" %}<div class="count">{{ "%02d"|format(i) }} / {{ "%02d"|format(n) }}</div>{% endif %}

{% set default_kicker = {"point": "Le point essentiel", "stat": "En chiffres", "compare": "Exemple · pour comprendre", "list": "Ta méthode de débutant", "cta": "Pour aller plus loin"} %}
<main id="main">
{% if s.type in ["cover", "hook"] %}
  <div class="kicker">{{ s.kicker or kicker }}</div>
  <div class="title">{{ s.title|md }}</div>
  {% if s.subtitle %}<div class="lead">{{ s.subtitle|md }}</div>{% endif %}
  {% if s.highlight %}<div class="hl">{{ s.highlight|md }}</div>{% endif %}

{% elif s.type in ["point", "stat", "compare"] %}
  <div class="kicker">{{ s.kicker or default_kicker[s.type] }}</div>
  {% if s.title %}<div class="title">{{ s.title|md }}</div>{% endif %}
  {% if s.body %}<div class="body">{% for p in s.body_paras %}<p>{{ p|md }}</p>{% endfor %}</div>{% endif %}
  {% set st = s.stat if s.type == "point" else ({"value": s.value, "unit": s.unit, "label": s.label} if s.type == "stat" else None) %}
  {% if st and st.value %}<div class="big">{{ st.value }}{% if st.unit %}<span class="unit">{{ st.unit }}</span>{% endif %}</div>{% if st.label %}<div class="big-lab">{{ st.label|md }}</div>{% endif %}{% endif %}
  {% if s.type == "compare" %}
  <div class="card"><div class="cols">{% for c in [s.left, s.right] %}<div class="col">
    <div class="lab{% if c.value %} grey{% endif %}">{{ c.label }}</div>
    {% if c.value %}<div class="val{% if c.win %} win{% endif %}">{{ c.value }}</div>{% endif %}
    {% if c.note %}<div class="txt">{{ c.note|md }}</div>{% endif %}
  </div>{% endfor %}</div>{% if s.caption %}<div class="cap">{{ s.caption|md }}</div>{% endif %}</div>
  {% elif s.cards %}
  <div class="card"><div class="cols">{% for c in s.cards[:2] %}<div class="col"><div class="val{% if c.win %} win{% endif %}" style="margin-top:0">{{ c.value }}</div><div class="txt">{{ c.label|md }}</div></div>{% endfor %}</div></div>
  {% endif %}
  {% if s.split %}<div class="split"><div class="l" style="flex:{{ s.split.left.weight or 1 }} 1 0"><div class="v">{{ s.split.left.value }}</div><div class="k">{{ s.split.left.label }}</div></div><div class="r" style="flex:{{ s.split.right.weight or 1 }} 1 0"><div class="v">{{ s.split.right.value }}</div><div class="k">{{ s.split.right.label }}</div></div></div>{% if s.split.note %}<div class="note">{{ s.split.note|md }}</div>{% endif %}{% endif %}
  {% if s.card_note %}<div class="card single">{{ s.card_note|md }}</div>{% endif %}
  {% if s.box %}<div class="box"><div class="h">{{ s.box.title }}</div><ul>{% for it in s.box["items"] %}<li>{{ it|md }}</li>{% endfor %}</ul></div>{% endif %}
  {% if s.note %}<div class="note">{{ s.note|md }}</div>{% endif %}
  {% if s.source %}<div class="source"><b>Source</b> · {{ s.source }}</div>{% endif %}

{% elif s.type == "list" %}
  <div class="kicker">{{ s.kicker or default_kicker.list }}</div>
  <div class="title">{{ s.title|md }}</div>
  <ol class="steps">{% for it in s["items"] %}<li><span class="n">{{ "%02d"|format(loop.index) }}</span><span class="t">
    {% if it is mapping %}<b>{{ it.title|md }}</b>{% if it.sub %}<span>{{ it.sub|md }}</span>{% endif %}{% else %}<b>{{ it|md }}</b>{% endif %}
  </span></li>{% endfor %}</ol>
  {% if s.source %}<div class="source"><b>Source</b> · {{ s.source }}</div>{% endif %}

{% elif s.type == "cta" %}
  <div class="kicker">{{ s.kicker or default_kicker.cta }}</div>
  <div class="title">{{ s.title|md }}</div>
  {% if s.subtitle or s.body %}<div class="lead">{{ (s.subtitle or s.body_paras[0])|md }}</div>{% endif %}
  <div class="mock">{% if guide_mockup %}<img src="{{ guide_mockup }}" alt="">{% endif %}
    <span class="cta-btn">{{ s.button if s.button and s.button|length <= 14 else "Lien en bio" }} <span>→</span></span></div>
{% endif %}
</main>

<footer>
  <span class="url">valorislab.be</span>
  <span class="disclaimer">{{ s.disclaimer or "Contenu éducatif · Pas un conseil financier" }}</span>
</footer>

<script>
window.__fit = async () => {
  await document.fonts.ready;
  await Promise.all([...document.images].map(im => im.complete ? 1 : new Promise(r => { im.onload = im.onerror = r; })));
  const m = document.getElementById('main');
  let s = 1;
  const root = document.documentElement;
  root.style.setProperty('--s', s);
  const wide = () => [...document.querySelectorAll('.big,.card .val,.split .v,.cta-btn')].some(e => e.scrollWidth > e.clientWidth + 1 || e.getBoundingClientRect().right > m.getBoundingClientRect().right + 1);
  const over = () => m.scrollHeight > m.clientHeight + 1 || m.scrollWidth > m.clientWidth + 1 || wide();
  let dropped = false;
  while (over() && s > 0.6) {
    s = +(s - 0.02).toFixed(2);
    // on a cover, the subtitle goes before the headline gets small
    const lead = document.querySelector('.t-cover .lead,.t-hook .lead');
    if (s < 0.86 && lead && !dropped) { lead.remove(); dropped = true; s = 1; }
    root.style.setProperty('--s', s);
  }
  return {scale: s, overflow: over(), dropped_lead: dropped};
};
</script>
</body>
</html>
