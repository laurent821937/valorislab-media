<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<style>
{% for w in [400,500,600,700,800] %}
@font-face{font-family:"Jakarta";src:url("../fonts/plus-jakarta-sans-latin-{{ w }}-normal.woff2") format("woff2");font-weight:{{ w }};unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:"Jakarta";src:url("../fonts/plus-jakarta-sans-latin-ext-{{ w }}-normal.woff2") format("woff2");font-weight:{{ w }};unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}
{% endfor %}
:root{
  --W:{{ W }}px; --H:{{ H }}px;
  --bg:#0A0A0B; --bg2:#121110;
  --ink:#F5F1EA; --body:#CBC5BB; --muted:#8F887D; --dim:#5E5850;
  --gold-1:#F3DB9C; --gold-2:#D3AA55; --gold-3:#9C7633; --gold:#D3AA55;
  --line:rgba(211,170,85,.22); --line-soft:rgba(245,241,234,.08);
  --acc-1:{{ acc1 }}; --acc-2:{{ acc2 }}; --acc-3:{{ acc3 }}; --acc:{{ acc2 }};
  --s:1; --u:calc(1px * var(--s));
  --pad-t:{{ pad_t }}px; --pad-r:{{ pad_r }}px; --pad-b:{{ pad_b }}px; --pad-l:{{ pad_l }}px;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{width:var(--W);height:var(--H);overflow:hidden;background:var(--bg)}
body{position:relative;color:var(--ink);font-family:"Jakarta",system-ui,sans-serif;-webkit-font-smoothing:antialiased;text-rendering:geometricPrecision}

/* atmosphere: warm light from the top-left like the logo photo, vignette, grain */
.bg{position:absolute;inset:0;
  background:
    radial-gradient(900px 700px at 8% -6%, rgba(232,196,120,.16), transparent 60%),
    radial-gradient(700px 900px at 112% 108%, color-mix(in srgb, var(--acc-2) 12%, transparent), transparent 62%),
    radial-gradient(1400px 1200px at 50% 40%, transparent 55%, rgba(0,0,0,.55) 100%),
    linear-gradient(170deg, var(--bg2), var(--bg) 60%);}
.grain{position:absolute;inset:0;opacity:.06;mix-blend-mode:overlay;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");}
.progress{position:absolute;left:var(--pad-l);right:var(--pad-r);top:calc(var(--pad-t) - 46px);height:3px;background:var(--line-soft);border-radius:3px;overflow:hidden}
.progress i{display:block;height:100%;width:{{ (i / n * 100)|round(2) }}%;background:linear-gradient(90deg,var(--gold-3),var(--gold-1));border-radius:3px}

.stage{position:absolute;top:var(--pad-t);right:var(--pad-r);bottom:var(--pad-b);left:var(--pad-l);display:flex;flex-direction:column;z-index:3}
header{display:flex;justify-content:space-between;align-items:center;flex:0 0 auto}
.brand{display:flex;align-items:center;gap:16px}
.brand .em{height:58px;width:auto}
.brand .wm{height:25px;width:auto;filter:brightness(1.25) saturate(1.05)}
.count{font-weight:700;font-size:24px;letter-spacing:.08em;color:var(--ink);font-variant-numeric:tabular-nums}
.count span{color:var(--dim);font-weight:600}
main{flex:1 1 auto;display:flex;flex-direction:column;justify-content:center;min-height:0;overflow:hidden;padding:calc(30 * var(--u)) 0}
footer{flex:0 0 auto;display:flex;justify-content:space-between;align-items:center;gap:20px;padding-top:22px;border-top:1px solid var(--line-soft)}
.author{display:flex;align-items:center;gap:16px}
.author img{width:64px;height:64px;border-radius:50%;box-shadow:0 0 0 2px var(--bg),0 0 0 4px var(--gold-2)}
.author b{display:block;font-weight:700;font-size:23px;letter-spacing:.01em}
.author small{display:block;font-weight:500;font-size:19px;color:var(--muted);letter-spacing:.02em;margin-top:2px}
.next{display:flex;align-items:center;gap:14px;font-weight:600;font-size:22px;letter-spacing:.06em;color:var(--body);text-transform:uppercase}
.next .arr{display:inline-grid;place-items:center;width:52px;height:52px;border-radius:50%;border:1.5px solid var(--gold-2);color:var(--gold-1);font-size:26px}
.next.url{color:var(--gold-1);text-transform:none;letter-spacing:.04em}

/* type */
.kicker{display:inline-flex;align-self:flex-start;align-items:center;gap:12px;padding:12px 20px 12px 16px;border:1px solid color-mix(in srgb,var(--acc-2) 45%,transparent);border-radius:999px;
  font-weight:700;font-size:calc(21 * var(--u));letter-spacing:.2em;text-transform:uppercase;color:var(--acc-1);background:color-mix(in srgb,var(--acc-2) 8%,transparent);margin-bottom:calc(34 * var(--u))}
.kicker::before{content:"";width:10px;height:10px;border-radius:50%;background:var(--acc-2);box-shadow:0 0 14px var(--acc-2)}
.t1{font-weight:800;font-size:calc({{ h1 }} * var(--u));line-height:1.03;letter-spacing:-.03em;text-wrap:balance}
.t2{font-weight:800;font-size:calc({{ h2 }} * var(--u));line-height:1.06;letter-spacing:-.025em;text-wrap:balance}
em{font-style:normal;background:linear-gradient(180deg,var(--acc-1) 0%,var(--acc-2) 55%,var(--acc-3) 100%);-webkit-background-clip:text;background-clip:text;color:transparent}
strong{font-weight:700;color:var(--ink)}
.lead{font-weight:500;font-size:calc({{ body }} * var(--u) * 1.05);line-height:1.45;color:var(--body);margin-top:calc(34 * var(--u))}
.body{font-weight:400;font-size:calc({{ body }} * var(--u));line-height:1.52;color:var(--body);margin-top:calc(32 * var(--u))}
.body p+p{margin-top:.75em}
.rule{width:96px;height:3px;border-radius:3px;background:linear-gradient(90deg,var(--gold-2),transparent);margin-top:calc(36 * var(--u))}

.idx{font-weight:800;font-size:calc(150 * var(--u));line-height:.85;letter-spacing:-.04em;color:transparent;-webkit-text-stroke:2px var(--gold-2);margin-bottom:calc(26 * var(--u));font-variant-numeric:tabular-nums}
.stat{white-space:nowrap;font-weight:800;font-size:calc({{ stat }} * var(--u));line-height:.9;letter-spacing:-.045em;background:linear-gradient(180deg,var(--gold-1),var(--gold-2) 60%,var(--gold-3));-webkit-background-clip:text;background-clip:text;color:transparent;font-variant-numeric:lining-nums}
.theme-crypto .stat{background-image:linear-gradient(180deg,var(--acc-1),var(--acc-2) 60%,var(--acc-3))}
.stat-label{font-weight:700;font-size:calc(24 * var(--u));letter-spacing:.18em;text-transform:uppercase;color:var(--muted);margin-top:calc(22 * var(--u))}
.card{border:1px solid var(--line);border-radius:28px;background:linear-gradient(180deg,rgba(255,255,255,.035),rgba(255,255,255,.01));padding:calc(34 * var(--u)) calc(38 * var(--u));margin-top:calc(38 * var(--u))}
.card .stat{font-size:calc({{ stat }} * var(--u) * .55)}

.cmp{display:grid;grid-template-columns:1fr 1fr;gap:calc(22 * var(--u));margin-top:calc(42 * var(--u))}
.cmp .col{border:1px solid var(--line-soft);border-radius:26px;padding:calc(32 * var(--u)) calc(28 * var(--u));background:rgba(255,255,255,.02)}
.cmp .col.win{border-color:var(--gold-2);background:linear-gradient(180deg,rgba(211,170,85,.12),rgba(211,170,85,.03))}
.cmp .lab{font-weight:700;font-size:calc(20 * var(--u));letter-spacing:.18em;text-transform:uppercase;color:var(--muted)}
.cmp .val{white-space:nowrap;font-weight:800;font-size:calc({{ stat }} * var(--u) * .42);letter-spacing:-.03em;line-height:1;margin:calc(16 * var(--u)) 0 calc(12 * var(--u));font-variant-numeric:lining-nums}
.cmp .win .val{background:linear-gradient(180deg,var(--gold-1),var(--gold-2));-webkit-background-clip:text;background-clip:text;color:transparent}
.cmp .note{font-size:calc(24 * var(--u));line-height:1.42;color:var(--body)}
.foot-note{font-size:calc(21 * var(--u));line-height:1.45;color:var(--muted);margin-top:calc(30 * var(--u))}

ol.list{list-style:none;margin-top:calc(40 * var(--u));display:flex;flex-direction:column;gap:calc(18 * var(--u))}
ol.list li{display:flex;gap:calc(24 * var(--u));align-items:flex-start;font-size:calc({{ body }} * var(--u));line-height:1.42;color:var(--body);padding:calc(22 * var(--u)) calc(26 * var(--u));border:1px solid var(--line-soft);border-radius:22px;background:rgba(255,255,255,.02)}
ol.list li .n{flex:0 0 auto;display:grid;place-items:center;width:1.55em;height:1.55em;border-radius:50%;font-weight:800;font-size:.82em;color:#16130D;background:linear-gradient(180deg,var(--gold-1),var(--gold-2))}

/* cover */
.t-cover main{justify-content:flex-start;padding-top:calc(70 * var(--u))}
.t-cover .copy{max-width:{{ cover_copy }}px}
.t-cover .lead{max-width:{{ cover_lead }}px}
.hero{position:absolute;z-index:2;right:{{ hero_right }}px;bottom:{{ hero_bottom }}px;height:{{ hero_h }}px;width:auto;filter:drop-shadow(0 30px 60px rgba(0,0,0,.6))}
.halo{position:absolute;z-index:1;right:{{ hero_right - 120 }}px;bottom:{{ hero_bottom - 40 }}px;width:{{ (hero_h * 0.95)|int }}px;height:{{ (hero_h * 0.95)|int }}px;border-radius:50%;
  background:radial-gradient(circle at 50% 45%, color-mix(in srgb,var(--acc-2) 30%,transparent), transparent 62%)}
.ring{position:absolute;z-index:1;right:{{ hero_right - 30 }}px;bottom:{{ hero_bottom + (hero_h * 0.22)|int }}px;width:{{ (hero_h * 0.62)|int }}px;height:{{ (hero_h * 0.62)|int }}px;border-radius:50%;border:1.5px solid color-mix(in srgb,var(--gold-2) 28%,transparent)}
.floor{position:absolute;z-index:1;right:{{ hero_right + 20 }}px;bottom:-30px;width:{{ (hero_h * 0.42)|int }}px;height:90px;border-radius:50%;background:radial-gradient(closest-side,rgba(0,0,0,.85),transparent)}
.t-cover footer{border-top-color:transparent;justify-content:flex-start}
.t-cover .next{position:relative;z-index:4}

/* cta */
.guide{display:flex;gap:calc(28 * var(--u));align-items:center;margin-top:calc(40 * var(--u))}
.book{flex:0 0 auto;width:calc(230 * var(--u));aspect-ratio:3/4.2;border-radius:18px;padding:calc(22 * var(--u));display:flex;flex-direction:column;justify-content:space-between;
  background:linear-gradient(160deg,#1B1915,#0C0B0A);border:1.5px solid var(--gold-2);box-shadow:0 30px 60px rgba(0,0,0,.55),inset 0 0 0 6px rgba(211,170,85,.08);transform:rotate(-4deg)}
.book .b1{font-weight:700;font-size:calc(11 * var(--u));letter-spacing:.2em;color:var(--gold-1)}
.book .b2{font-weight:800;font-size:calc(30 * var(--u));line-height:1.02;letter-spacing:-.02em}
.book .b3{font-weight:700;font-size:calc(12 * var(--u));letter-spacing:.16em;color:var(--gold-2)}
.book img{width:42%;align-self:flex-start}
.cta-btn{display:inline-flex;align-items:center;gap:14px;margin-top:calc(40 * var(--u));padding:calc(24 * var(--u)) calc(36 * var(--u));border-radius:999px;
  background:linear-gradient(180deg,var(--gold-1),var(--gold-2));color:#16130D;font-weight:800;font-size:calc(25 * var(--u));letter-spacing:.06em;text-transform:uppercase;box-shadow:0 14px 40px rgba(211,170,85,.25)}
.disclaimer{font-size:calc(21 * var(--u));line-height:1.45;color:var(--muted);margin-top:calc(30 * var(--u))}
</style>
</head>
<body class="t-{{ s.type }} theme-{{ theme }} fmt-{{ fmt }}">
<div class="bg"></div>
<div class="grain"></div>
<div class="progress"><i></i></div>
{% if s.type == "cover" %}
<div class="halo"></div><div class="ring"></div>{% if character != "34" %}<div class="floor"></div>{% endif %}
<img class="hero" src="../assets/char-{{ character }}.webp" alt="">
{% endif %}
<div class="stage">
  <header>
    <div class="brand"><img class="em" src="../assets/logo-emblem.webp" alt=""><img class="wm" src="../assets/logo-wordmark.webp" alt=""></div>
    <div class="count">{{ "%02d"|format(i) }}<span> / {{ "%02d"|format(n) }}</span></div>
  </header>
  <main id="main">
  {% if s.type == "cover" %}
    <div class="copy">
      <div class="kicker">{{ kicker }}</div>
      <div class="t1">{{ s.title|md }}</div>
      <div class="rule"></div>
      {% if s.subtitle %}<div class="lead">{{ s.subtitle|md }}</div>{% endif %}
    </div>
  {% elif s.type == "point" %}
    {% if s.index %}<div class="idx">{{ s.index }}</div>{% endif %}
    <div class="t2">{{ s.title|md }}</div>
    {% if s.body %}<div class="body">{% for p in s.body_paras %}<p>{{ p|md }}</p>{% endfor %}</div>{% endif %}
    {% if s.stat %}<div class="card"><div class="stat">{{ s.stat.value|md }}</div><div class="stat-label">{{ s.stat.label }}</div></div>{% endif %}
  {% elif s.type == "stat" %}
    {% if s.title %}<div class="t2" style="margin-bottom:calc(40 * var(--u))">{{ s.title|md }}</div>{% endif %}
    <div class="stat">{{ s.value|md }}</div>
    <div class="stat-label">{{ s.label }}</div>
    {% if s.body %}<div class="body">{% for p in s.body_paras %}<p>{{ p|md }}</p>{% endfor %}</div>{% endif %}
  {% elif s.type == "compare" %}
    <div class="t2">{{ s.title|md }}</div>
    <div class="cmp">
      {% for c in [s.left, s.right] %}
      <div class="col{% if c.win %} win{% endif %}"><div class="lab">{{ c.label }}</div><div class="val">{{ c.value|md }}</div><div class="note">{{ c.note|md }}</div></div>
      {% endfor %}
    </div>
    {% if s.note %}<div class="foot-note">{{ s.note|md }}</div>{% endif %}
  {% elif s.type == "list" %}
    <div class="t2">{{ s.title|md }}</div>
    <ol class="list">{% for it in s["items"] %}<li><span class="n">{{ loop.index }}</span><span>{{ it|md }}</span></li>{% endfor %}</ol>
  {% elif s.type == "cta" %}
    <div class="t2">{{ s.title|md }}</div>
    <div class="guide">
      <div class="book"><img src="../assets/logo-emblem.webp" alt=""><div><div class="b1">GUIDE INTERACTIF 2026</div><div class="b2" style="margin-top:10px">20 erreurs de débutant</div></div><div class="b3">BOURSE / CRYPTO</div></div>
      {% if s.body %}<div class="body" style="margin-top:0">{% for p in s.body_paras %}<p>{{ p|md }}</p>{% endfor %}</div>{% endif %}
    </div>
    <div><span class="cta-btn">{{ s.button }} <span>→</span></span></div>
    {% if s.disclaimer %}<div class="disclaimer">{{ s.disclaimer }}</div>{% endif %}
  {% endif %}
  </main>
  <footer>
    {% if s.type != "cover" %}<div class="author"><img src="../assets/avatar.webp" alt=""><div><b>Laurent</b><small>Fondateur de VALORISLAB</small></div></div>{% endif %}
    {% if i < n %}<div class="next">Glisse <span class="arr">→</span></div>{% else %}<div class="next url">valorislab.be</div>{% endif %}
  </footer>
</div>
<script>
window.__fit = async () => {
  await document.fonts.ready;
  await Promise.all([...document.images].map(im => im.complete ? 1 : new Promise(r => { im.onload = im.onerror = r; })));
  const m = document.getElementById('main');
  let s = 1;
  const root = document.documentElement;
  root.style.setProperty('--s', s);
  const over = () => m.scrollHeight > m.clientHeight + 1 || m.scrollWidth > m.clientWidth + 1 || [...document.querySelectorAll('.stat,.val')].some(e => e.scrollWidth > e.clientWidth + 1);
  while (over() && s > 0.6) {
    s = +(s - 0.02).toFixed(2);
    root.style.setProperty('--s', s);
  }
  return {scale: s, overflow: over()};
};
</script>
</body>
</html>
